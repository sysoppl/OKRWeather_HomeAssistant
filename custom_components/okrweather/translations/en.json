    "step": {
      "user": {
        "title": "Connect to OKRWeather",
        "description": "Leave the API key blank for free public weather data. Paste your premium API key to unlock the AI insights (comfort index, radar analysis, storm tracker, pressure & frost alerts, solar forecast, air-quality trend).",
